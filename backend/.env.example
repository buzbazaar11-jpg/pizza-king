# ─────────────────────────────────────────────────────────────────────────────
# Pizza King FastAPI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase PostgreSQL (Session Pooler) ─────────────────────────────────────
# Get this from: Supabase Dashboard → Project Settings → Database
#   → Connection string → URI  (choose "Session pooler", port 5432)
# Replace [YOUR-PASSWORD] with your Supabase database password.
#
# HYBRID MODE: set either or both blocks below.
#  - Only DATABASE_URL       -> direct SQLAlchemy
#  - Only SUPABASE_*         -> Supabase REST client
#  - Both                    -> both active (recommended)
# Leave a value empty to disable that option.
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-min-32-chars

# ── Redis (optional — set to empty string to disable) ────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS Origins (comma-separated list as JSON array) ────────────────────────
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3000","https://your-vercel-domain.vercel.app"]

# ── Business / Delivery Settings ──────────────────────────────────────────────
CENTER_LAT=33.5651
CENTER_LNG=73.1486
MAX_DELIVERY_RADIUS_KM=7.0

# ── Supabase REST (URL + keys) ───────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never in frontend
SUPABASE_ANON_KEY=your-anon-key

# The frontend reaches your data ONLY through FastAPI (/gateway). SUPABASE_URL +
# SUPABASE_ANON_KEY are REQUIRED for the website/admin/POS/rider to work.
